  </defs>
  <rect width="1000" height="800" fill="url(#bg)"/>
  <rect width="1000" height="800" fill="url(#accent)"/>
  
  <circle cx="500" cy="360" r="133.33333333333334" fill="#A61E4D" opacity="0.15"/>
  <circle cx="500" cy="360" r="88.88888888888889" fill="#D6B98C" opacity="0.2"/>
  
